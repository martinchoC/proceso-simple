; =============================================================================
;  Copiar este archivo como .env  (mismo directorio) y completar SOLO el
;  bloque 1. Todo lo demás tiene valores por defecto correctos o se detecta
;  automáticamente desde la base de datos.
;
;  IMPORTANTE: .env nunca debe quedar dentro de public_html.
; =============================================================================

; --- 1. BASE DE DATOS (lo único obligatorio) ---------------------------------
; Datos de hPanel → Bases de datos → Administración de bases MySQL.
; Es la MISMA base que usa el sistema de usuarios, perfiles, módulos y empresas.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

; Clave de la aplicación. Generar una vez y no cambiarla:
;   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

; =============================================================================
;  A partir de acá NO hace falta tocar nada.
; =============================================================================

; --- 2. Aplicación -----------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
; Dejar VACÍO: las URLs se arman relativas al dominio, así funciona igual en
; dominio, subdominio, subcarpeta y staging sin editar este archivo.
APP_URL=
DB_CHARSET=utf8mb4

; --- 3. Sesión ---------------------------------------------------------------
SESSION_NAME=ECOMSID
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_MINUTES=480
; true requiere HTTPS activo. Poner false SOLO si todavía no activaste el SSL.
SESSION_SECURE=true
SESSION_SAMESITE=Lax

; --- 4. Anti fuerza bruta ----------------------------------------------------
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
LOGIN_BLOQUEO_MINUTOS=15

; --- 5. Identidad del cliente ------------------------------------------------
; Para entrar, conf__usuarios.usuario debe ser igual al documento de una
; entidad cliente activa de la empresa. Acá se indica qué columna de
; gestion__entidades guarda ese documento. Valores admitidos: cuil | cuit.
ECOM_ENTIDAD_DOC_COLUMNA=cuil

; --- 6. Catálogo -------------------------------------------------------------
CATALOGO_PAGE_SIZE=24
CATALOGO_MAX_PAGE_SIZE=60

; --- 7. IDs de negocio (detección automática) --------------------------------
; Dejar en 0 = la aplicación los resuelve sola desde la base:
;   ECOM_MODULO_ID                -> conf__modulos, módulo "Ecommerce B2B"
;   ECOM_EMPRESA_ID               -> única empresa con perfil activo del módulo
;   ECOM_SUCURSAL_ID              -> primera sucursal con punto de venta
;   ECOM_MONEDA_ID                -> moneda base de la empresa
;   ECOM_COMPROBANTE_TIPO_PEDIDO_ID -> tipo "Pedido de Cliente" (código PC)
;   ECOM_TABLA_ORIGEN_PEDIDOS_ID  -> conf__tablas -> gestion__ventas_pedidos
;   ECOM_LISTA_PRECIO_DEFAULT_ID  -> única lista activa (0 = sin fallback)
;
; Completar SOLO si la base tiene más de una empresa usando el módulo, o si
; querés forzar una configuración distinta a la detectada.
ECOM_MODULO_ID=0
ECOM_EMPRESA_ID=0
ECOM_SUCURSAL_ID=0
ECOM_MONEDA_ID=0
ECOM_COMPROBANTE_TIPO_PEDIDO_ID=0
ECOM_TABLA_ORIGEN_PEDIDOS_ID=0
ECOM_LISTA_PRECIO_DEFAULT_ID=0
