# =============================================================================
#  Hostinger (LiteSpeed / Apache 2.4)
#  Ubicación: public_html/ps_ecommerce/.htaccess   (junto a index.php)
#  URL resultante: https://tudominio.com/ps_ecommerce/
#
#  Si renombrás la carpeta, cambiá SOLO la línea RewriteBase.
# =============================================================================

# Sin esto, una petición al directorio puede terminar en 403 (Forbidden)
# cuando el servidor no encuentra un índice y los listados están desactivados.
DirectoryIndex index.php

# --- Forzar HTTPS -------------------------------------------------------------
# Descomentar una vez que el certificado SSL esté activo en hPanel.
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Front controller ---------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /casalucho/carrito/

    # La carpeta de la aplicación nunca se sirve por HTTP
    RewriteRule ^ecommerce_app(/|$) - [F,L]

    # Sólo los ARCHIVOS existentes (assets) se sirven directo.
    # Todo lo demás —incluidos los directorios— va al front controller, así
    # ninguna petición puede caer en un listado de directorio ni en un 403.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# --- Endurecimiento -----------------------------------------------------------
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    # Activar sólo con HTTPS funcionando en todo el dominio:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Nunca servir archivos sensibles
<FilesMatch "(^\.env|^\.env\..*|\.log|\.sql|\.md|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear cualquier archivo oculto (.git, .htpasswd, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Caché de assets estáticos ------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/png              "access plus 30 days"
    ExpiresByType image/jpeg             "access plus 30 days"
    ExpiresByType image/webp             "access plus 30 days"
</IfModule>
